# Vite env vars must be prefixed with VITE_ to be exposed to the client
VITE_API_BASE=/api
VITE_APP_TITLE=Padel Play

# Turso — for `pnpm db:init` / drizzle-kit (Node-side, NOT exposed to client)
# Copy to .env or set in shell. For Pages Functions, use .dev.vars + Cloudflare Dashboard instead.
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="eyJ..."
